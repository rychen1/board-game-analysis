# Copy to .env for local overrides. Do not commit .env.

# Canonical database (PostgreSQL). Unused until a storage layer is added.
DATABASE_URL=postgresql://board_game_analysis:board_game_analysis@localhost:5432/board_game_analysis

# docker compose postgres service
POSTGRES_USER=board_game_analysis
POSTGRES_PASSWORD=board_game_analysis
POSTGRES_DB=board_game_analysis
POSTGRES_PORT=5432

# Optional data root for raw/processed archives (default: ./data)
# DATA_DIR=data

# BoardGameGeek XML API2 (required for live ingest; never commit the token)
# Register an application at https://boardgamegeek.com/applications
# BGG_TOKEN=
BGG_BASE_URL=https://boardgamegeek.com/xmlapi2
BGG_TIMEOUT_SECONDS=30
BGG_RATE_LIMIT_SECONDS=5
BGG_MAX_RETRIES=4
BGG_RETRY_BACKOFF_SECONDS=2
HTTP_USER_AGENT=board-game-analysis/0.1.0 (research ingestion; https://github.com/rychen1/board-game-analysis)
