# Copy to .env for local overrides. Do not commit .env.

# Canonical database (PostgreSQL). Unused until a storage layer is added.
DATABASE_URL=postgresql://board_game_analysis:board_game_analysis@localhost:5432/board_game_analysis

# docker compose postgres service
POSTGRES_USER=board_game_analysis
POSTGRES_PASSWORD=board_game_analysis
POSTGRES_DB=board_game_analysis
POSTGRES_PORT=5432
